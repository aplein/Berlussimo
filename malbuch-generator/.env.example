# Port, auf dem die Malbuch-App selbst läuft
APP_PORT=5010

# Adresse der Fooocus-API (Standard-Port 8888)
FOOOCUS_API_URL=http://127.0.0.1:8888

# Fooocus-Performance: Speed | Quality | "Extreme Speed"
FOOOCUS_PERFORMANCE=Speed

# Seitenverhältnis im Fooocus-Format "Breite*Höhe" (Hochformat für Buchseiten)
FOOOCUS_ASPECT_RATIO=896*1152

# Sicherheitsgrenze für die Bildanzahl pro Auftrag
MAX_IMAGES=60

# Timeout pro Bild in Sekunden
GENERATION_TIMEOUT=600
